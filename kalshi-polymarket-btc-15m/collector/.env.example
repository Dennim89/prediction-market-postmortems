# Copy to .env and uncomment what you want to change.  Every value is optional and
# shown with its default.  Nothing here is secret: the collector reads public
# endpoints and needs no keys.  Environment variables override config.yaml.

# Providers: MARKET_PROVIDER is polymarket or mock, SPOT_PROVIDER is rtds or mock.
# "mock" means synthetic data and no network.
# MARKET_PROVIDER=polymarket
# SPOT_PROVIDER=rtds

# Public endpoints
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
# POLYMARKET_BITCOIN_TAG_ID=235

# Output folder (raw/ and ticks/ go inside)
# OUTPUT_DIR=./data

# Intervals and tolerances, seconds
# TICK_INTERVAL_SEC=5
# ORDERBOOK_POLL_SEC=1
# SPOT_POLL_SEC=2
# MARKET_DISCOVERY_SEC=10
# OPEN_PRICE_MAX_LAG_SEC=5

# Order book levels kept per side
# L2_DEPTH=10

# LOG_LEVEL=INFO
